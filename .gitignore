/target
**/*.rs.bk

# P0 probes are standalone crates with their own target directories
/probes/*/target

# snapshot/patch review leftovers
*.snap.new
*.rej
*.orig

# SBOMs, written beside a crate's manifest by `cargo cyclonedx` before
# `cargo xtask dist` moves them into `target/distrib/`
*.cdx.xml

# web (P11)
web/node_modules
web/dist

# docs site
site/node_modules
site/dist
site/.astro
# The palette solver the showcase page runs, built by `cargo xtask showcase` (and
# by the docs workflow): a build output, not an artefact to keep in step by hand.
site/public/showcase/*.wasm

# session history captured for resuming work locally; not part of the product
.history/
HISTORY.md

# Python scratch from the tools in .github/scripts
__pycache__/
*.pyc

# local runtime state
.acpilot/
*.sqlite
*.sqlite-wal
*.sqlite-shm

.DS_Store
