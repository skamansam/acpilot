---
source: crates/acpilot-proto/tests/openapi_snapshot.rs
expression: canonical(document)
---
{
  "components": {
    "schemas": {
      "AcpBridgeSummary": {
        "description": "The bridge as returned by `GET /v1/acp/bridge`.",
        "properties": {
          "bind": {
            "description": "Address the HTTP transport listens on, when it is enabled.",
            "type": [
              "string",
              "null"
            ]
          },
          "connected": {
            "description": "Connected drivers.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "enabled": {
            "description": "Whether the endpoint is listening at all. Off unless configured.",
            "type": "boolean"
          },
          "known_drivers": {
            "description": "Drivers on record, including revoked ones.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "public_url": {
            "description": "Externally reachable URL, for the driver's configuration.",
            "type": [
              "string",
              "null"
            ]
          },
          "require_token": {
            "description": "Whether a bearer token is required. Loopback-only endpoints may disable\nit; anything else may not.",
            "type": "boolean"
          },
          "transports": {
            "description": "Transports currently served.",
            "items": {
              "$ref": "#/components/schemas/BridgeTransport"
            },
            "type": "array"
          }
        },
        "required": [
          "enabled",
          "transports",
          "require_token",
          "connected",
          "known_drivers"
        ],
        "type": "object"
      },
      "AcpDriverSummary": {
        "description": "A driver as returned by `GET /v1/acp/drivers`.",
        "properties": {
          "client": {
            "description": "Client name and version reported by `initialize`, for example\n`devin 2.1`. Recorded, not trusted.",
            "type": [
              "string",
              "null"
            ]
          },
          "connected_at": {
            "description": "RFC 3339 timestamp of the current connection.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Driver identifier, stable across reconnects."
          },
          "last_seen_at": {
            "description": "RFC 3339 timestamp of the last request.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "Name the driver gave during the handshake.",
            "type": "string"
          },
          "peer": {
            "description": "Peer address, or `stdio` for a local process.",
            "type": "string"
          },
          "prompt_turns": {
            "description": "Turns this driver has prompted; the audit trail at a glance.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "scopes": {
            "description": "Scopes actually granted, which may be fewer than requested.",
            "items": {
              "$ref": "#/components/schemas/DriverScope"
            },
            "type": "array"
          },
          "sessions": {
            "description": "Sessions this driver has open.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/DriverStatus",
            "description": "Current state."
          }
        },
        "required": [
          "id",
          "name",
          "peer",
          "status",
          "scopes",
          "sessions",
          "prompt_turns"
        ],
        "type": "object"
      },
      "AddProviderRequest": {
        "description": "Request body for `POST /v1/providers`.\n\nA provider is inert until it is declared here *and* enabled. There is no\nscanning for servers on the loopback interface: a network call is something\nthe user asked for, not something that happens during startup.",
        "properties": {
          "base_url": {
            "description": "Base URL, for example `http://127.0.0.1:1234`.",
            "type": "string"
          },
          "credential_ref": {
            "description": "Keyring entry to read a bearer token from, for servers that require one.",
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "description": "Whether the provider may be contacted after it is added.",
            "type": "boolean"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Identifier to store it under."
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind",
            "description": "Wire dialect."
          },
          "label": {
            "description": "Display label.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "base_url",
          "enabled"
        ],
        "type": "object"
      },
      "AgentStatus": {
        "description": "Whether an agent can be used right now.",
        "enum": [
          "available",
          "missing",
          "unhealthy",
          "untrusted"
        ],
        "type": "string"
      },
      "AgentSummary": {
        "description": "An agent as returned by `GET /v1/agents`.",
        "properties": {
          "command": {
            "description": "Command that will be spawned, for display and debugging.",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Agent identifier."
          },
          "name": {
            "description": "Human-readable name.",
            "type": "string"
          },
          "protocol_version": {
            "description": "Protocol version reported by the last handshake, when there was one.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AgentStatus",
            "description": "Current availability."
          },
          "transport": {
            "$ref": "#/components/schemas/AgentTransport",
            "description": "How the agent is driven."
          }
        },
        "required": [
          "id",
          "name",
          "transport",
          "status",
          "command"
        ],
        "type": "object"
      },
      "AgentTransport": {
        "description": "Transport used to drive an agent.\n\n`AcpStdio` is the native path. `Pty` is the program-as-agent adapter, which\nlets an ordinary TUI program (freebuff, claude, anything) participate through\na transcript parser. `HttpJsonRpc` is reserved for remote agents.",
        "enum": [
          "acp_stdio",
          "pty",
          "http_json_rpc"
        ],
        "type": "string"
      },
      "BridgeTransport": {
        "description": "Transport a driver is attached over.",
        "enum": [
          "stdio",
          "http_json_rpc"
        ],
        "type": "string"
      },
      "CancelAccepted": {
        "description": "Response to a cancel request.\n\n`cancelled` is false when the session had no turn in flight: the caller's\nintent (\"stop\") was already true, which is not an error.",
        "properties": {
          "cancelled": {
            "description": "Whether a turn was in flight when the cancel arrived.",
            "type": "boolean"
          },
          "turn_id": {
            "description": "The turn that was running, when one was.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "cancelled"
        ],
        "type": "object"
      },
      "ContextBudget": {
        "description": "The budget for one run, in tokens except where stated.",
        "properties": {
          "max_corpus_bytes": {
            "description": "Ceiling on corpus text, in bytes, before tokenisation.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "reserve_output": {
            "description": "Tokens held back for the answer.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "strategy": {
            "$ref": "#/components/schemas/ContextStrategy",
            "description": "What to do on overflow."
          },
          "window": {
            "description": "Total window to plan against. Defaults to the model's reported value.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "window",
          "reserve_output",
          "strategy",
          "max_corpus_bytes"
        ],
        "type": "object"
      },
      "ContextStats": {
        "description": "Context-window usage for one integration.",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/StatSource",
            "description": "Where `used_tokens` and `window_tokens` came from."
          },
          "used_tokens": {
            "description": "Tokens currently in the conversation, including the system prompt and\nany corpus that was assembled for the next turn.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "window_tokens": {
            "description": "The window to measure against. Absent when neither the server nor the\nrecipe states one; a client must not substitute a default.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "used_tokens",
          "source"
        ],
        "type": "object"
      },
      "ContextStrategy": {
        "description": "What to do when the assembled prompt would exceed the window.",
        "enum": [
          "truncate_oldest",
          "summarize",
          "refuse"
        ],
        "type": "string"
      },
      "CorpusSelector": {
        "description": "One way to pull text out of the workspace into the prompt.",
        "properties": {
          "glob": {
            "description": "Glob relative to the workspace root, for example `docs/**/*.md`.",
            "type": "string"
          },
          "max_bytes": {
            "description": "Maximum bytes per file, so one generated lockfile cannot eat the budget.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "max_files": {
            "description": "Maximum number of files to include.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "glob",
          "max_files",
          "max_bytes"
        ],
        "type": "object"
      },
      "CreateSessionRequest": {
        "description": "Request body for `POST /v1/sessions`.",
        "properties": {
          "agent_id": {
            "$ref": "#/components/schemas/String",
            "description": "Agent to run."
          },
          "title": {
            "description": "Optional title; the first prompt supplies one otherwise.",
            "type": [
              "string",
              "null"
            ]
          },
          "workspace_id": {
            "$ref": "#/components/schemas/String",
            "description": "Workspace to attach the session to."
          }
        },
        "required": [
          "workspace_id",
          "agent_id"
        ],
        "type": "object"
      },
      "CreateTerminalRequest": {
        "description": "Request body for `POST /v1/terminals`.\n\nA terminal belongs to a session because that is who owns the work it is doing;\na shell with no session would be a second, sessionless way to run commands on\nthe daemon's host.",
        "properties": {
          "args": {
            "description": "Arguments for `command`, verbatim.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "description": "Program to run. Defaults to the daemon host's own shell.",
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "description": "Directory to start in, relative to the workspace root. Defaults to the root.",
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "$ref": "#/components/schemas/String",
            "description": "Session that owns the terminal."
          },
          "size": {
            "$ref": "#/components/schemas/TerminalSize",
            "description": "Initial dimensions. Both must be non-zero: a terminal with no columns\ncannot display anything, and `vt100` takes `NonZeroU16` for the same reason."
          }
        },
        "required": [
          "session_id",
          "size"
        ],
        "type": "object"
      },
      "CreditStats": {
        "description": "Credit balance for one integration.\n\nAmounts are in the provider's own unit — credits, not necessarily currency —\nand `currency` carries the label to show. Any field may be absent: some\nproviders report only a balance, some only usage, and local servers report\nneither. [`limit`](Self::limit) is separate because a remaining balance is not\nthe same as a plan ceiling.",
        "properties": {
          "currency": {
            "description": "What the amounts are counted in, for example `credits` or `USD`.",
            "type": "string"
          },
          "limit": {
            "description": "Plan ceiling for the period, when reported. With `used` this makes the\nbar's denominator; without it the bar is indeterminate.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "remaining": {
            "description": "Credits left, when reported.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/StatSource",
            "description": "Where the figures came from."
          },
          "used": {
            "description": "Credits spent in the current billing period, when reported.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "currency",
          "source"
        ],
        "type": "object"
      },
      "DiscoveredModel": {
        "description": "A model the provider reported, as returned by `GET /v1/models`.",
        "properties": {
          "architecture": {
            "description": "Architecture as reported, for example `llama` or `qwen2_vl`.",
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities": {
            "$ref": "#/components/schemas/ModelCapabilities",
            "description": "What the model appears able to do."
          },
          "context_source": {
            "$ref": "#/components/schemas/MetadataSource",
            "description": "Where `context_window` came from."
          },
          "context_window": {
            "description": "Context window in tokens, when the server says.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "description": "Model identifier to send in a request.",
            "type": "string"
          },
          "loaded": {
            "description": "Whether the server currently holds it in memory. Absent when the dialect\ndoes not report load state, which is most of them.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "model_type": {
            "$ref": "#/components/schemas/ModelType",
            "description": "Broad class, from the server's typing."
          },
          "provider_id": {
            "$ref": "#/components/schemas/String",
            "description": "Provider that reported it."
          },
          "quantization": {
            "description": "Quantization as reported, for example `Q4_K_M`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "provider_id",
          "model_type",
          "context_source",
          "capabilities"
        ],
        "type": "object"
      },
      "DriverScope": {
        "description": "What a driver is allowed to do.",
        "enum": [
          "observe",
          "prompt",
          "cancel",
          "answer_permissions"
        ],
        "type": "string"
      },
      "DriverStatus": {
        "description": "State of a driver connection.",
        "enum": [
          "pending_pairing",
          "connected",
          "disconnected",
          "revoked"
        ],
        "type": "string"
      },
      "ErrorBody": {
        "description": "Machine-readable error payload.\n\n`code` is a stable, documented identifier (`invalid_request`, `not_found`,\n`conflict`, `permission_denied`, `timeout`, `host_unavailable`,\n`model_unavailable`, `agent_failed`, `protocol`, `io`). Clients switch on\n`code`; `message` is for humans and may be reworded.",
        "properties": {
          "code": {
            "description": "Stable identifier for the failure class.",
            "type": "string"
          },
          "details": {
            "description": "Field-level detail, when the failure is attributable to specific inputs.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "message": {
            "description": "Human-readable explanation.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "description": "One field-level entry in an [`ErrorBody`].",
        "properties": {
          "field": {
            "description": "Dotted path of the offending field, for example `preferences.wrap`.",
            "type": "string"
          },
          "message": {
            "description": "What is wrong with it.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "ExtensionContribution": {
        "description": "One thing an extension provides, named as the profile will see it.",
        "properties": {
          "id": {
            "description": "Identifier inside that registry, for example `rust-analyzer` or\n`night-flight`.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ExtensionKind",
            "description": "Which registry the id lands in."
          },
          "summary": {
            "description": "One line of description, so `ext list` is readable without the manifest.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "summary"
        ],
        "type": "object"
      },
      "ExtensionDetail": {
        "description": "One extension, in full, as returned by `GET /v1/extensions/{id}`.",
        "properties": {
          "active_profiles": {
            "description": "Profiles that have it activated.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "contributions": {
            "description": "Everything it contributes, flattened.",
            "items": {
              "$ref": "#/components/schemas/ExtensionContribution"
            },
            "type": "array"
          },
          "manifest": {
            "description": "The manifest as written, for reviewing before enabling.",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/ExtensionSummary",
            "description": "The same summary the list endpoint returns."
          }
        },
        "required": [
          "summary",
          "contributions",
          "manifest",
          "active_profiles"
        ],
        "type": "object"
      },
      "ExtensionKind": {
        "description": "What an extension contributes.\n\nOne extension may contribute several kinds; a \"Rust pack\" is a bundle rather\nthan a category, which is why this is a list on the summary and a single value\non each contribution.",
        "enum": [
          "theme",
          "language_servers",
          "agents",
          "grammars",
          "snippets",
          "keymap",
          "transcript_parser"
        ],
        "type": "string"
      },
      "ExtensionSource": {
        "description": "How the extension got here.",
        "enum": [
          "registry",
          "path"
        ],
        "type": "string"
      },
      "ExtensionStatus": {
        "description": "Verification and activation state.",
        "enum": [
          "installed",
          "active",
          "disabled",
          "blocked"
        ],
        "type": "string"
      },
      "ExtensionSummary": {
        "description": "An extension as returned by `GET /v1/extensions`.",
        "properties": {
          "checksum": {
            "description": "SHA-256 of the installed directory, verified against the index.",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "description": "One sentence, shown in the list.",
            "type": "string"
          },
          "homepage": {
            "description": "Project page or repository, for a reader deciding whether to trust it.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Namespaced identifier, `publisher.id`."
          },
          "installed_at": {
            "description": "RFC 3339 timestamp of installation.",
            "type": [
              "string",
              "null"
            ]
          },
          "kinds": {
            "description": "Everything it contributes.",
            "items": {
              "$ref": "#/components/schemas/ExtensionKind"
            },
            "type": "array"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "publisher": {
            "description": "Who published it, as the index records them.",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ExtensionSource",
            "description": "Where it came from."
          },
          "status": {
            "$ref": "#/components/schemas/ExtensionStatus",
            "description": "Verification and activation state."
          },
          "version": {
            "description": "Semantic version from the manifest.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "publisher",
          "description",
          "kinds",
          "status",
          "source"
        ],
        "type": "object"
      },
      "FileContent": {
        "description": "File contents plus the token needed to write them back.",
        "properties": {
          "etag": {
            "description": "Opaque validator; send it back as `if_match` to write.",
            "type": "string"
          },
          "path": {
            "description": "Workspace-relative path.",
            "type": "string"
          },
          "text": {
            "description": "UTF-8 contents. Binary files are refused rather than mangled.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "text",
          "etag"
        ],
        "type": "object"
      },
      "FileEntry": {
        "description": "One directory entry.",
        "properties": {
          "is_dir": {
            "description": "Whether this is a directory.",
            "type": "boolean"
          },
          "modified": {
            "description": "RFC 3339 modification time, when the host reports one.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Path relative to the workspace root, using `/` as the separator everywhere.",
            "type": "string"
          },
          "size": {
            "description": "Size in bytes; zero for directories.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "is_dir",
          "size"
        ],
        "type": "object"
      },
      "FileWriteRequest": {
        "description": "Request body for `PUT /v1/files`.",
        "properties": {
          "if_match": {
            "description": "The `etag` the caller last read, or absent to create a new file.\n\nA mismatch is a `409`, never a silent overwrite.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Workspace-relative path.",
            "type": "string"
          },
          "text": {
            "description": "New UTF-8 contents.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "text"
        ],
        "type": "object"
      },
      "HostCapabilities": {
        "description": "What a host can actually do.\n\nCapabilities are discovered rather than assumed: a host that cannot spawn\nprocesses still edits files, and the UIs need to know that before offering an\nagent.",
        "properties": {
          "filesystem": {
            "description": "Can the daemon read and write files here?",
            "type": "boolean"
          },
          "lsp": {
            "description": "Can the daemon run language servers here?",
            "type": "boolean"
          },
          "pty": {
            "description": "Can the daemon allocate a PTY here?",
            "type": "boolean"
          },
          "spawn": {
            "description": "Can the daemon spawn agent processes here?",
            "type": "boolean"
          }
        },
        "required": [
          "filesystem",
          "pty",
          "spawn",
          "lsp"
        ],
        "type": "object"
      },
      "HostKind": {
        "description": "How the daemon reaches a host.",
        "enum": [
          "local",
          "ssh",
          "wsl"
        ],
        "type": "string"
      },
      "HostSummary": {
        "description": "A host as returned by `GET /v1/hosts`.",
        "properties": {
          "capabilities": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/HostCapabilities",
                "description": "Negotiated capabilities, absent until the host has been reached once."
              },
              {
                "type": "null"
              }
            ]
          },
          "connected": {
            "description": "Whether the last connection attempt succeeded.",
            "type": "boolean"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Host identifier."
          },
          "kind": {
            "$ref": "#/components/schemas/HostKind",
            "description": "Transport used to reach the host."
          },
          "label": {
            "description": "Human-readable label.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "connected"
        ],
        "type": "object"
      },
      "InstallExtensionRequest": {
        "description": "Request body for `POST /v1/extensions`.\n\nExactly one of `version` (registry) or `path` (local directory) is used;\n`path` wins when both are present, because a developer typing a path means it.",
        "properties": {
          "activate": {
            "description": "Activate it in the profile named by `X-Acpilot-Profile` after verifying.",
            "type": "boolean"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Identifier from the index, or the manifest's id for a path install."
          },
          "path": {
            "description": "Directory to link instead of downloading.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "Version to install. The index's latest when absent.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "activate"
        ],
        "type": "object"
      },
      "IntegrationKind": {
        "description": "What the stats describe.\n\nProviders and agents share the bar because they share the questions, not\nbecause they share a lifecycle: a provider can serve several agents, and an\nagent can outlive the provider that answered its last turn.",
        "enum": [
          "provider",
          "agent"
        ],
        "type": "string"
      },
      "IntegrationStats": {
        "description": "One integration's stats, as returned by `GET /v1/stats`.\n\nA list of these is what the stats bar renders. Integrations with nothing\nreported still appear, with `source: unknown`, so the bar has a stable row\ninstead of disappearing when a provider is quiet.",
        "properties": {
          "context": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ContextStats",
                "description": "Context usage, absent when the integration has no conversation attached\n(a provider that has not served a turn, for example)."
              },
              {
                "type": "null"
              }
            ]
          },
          "credits": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CreditStats",
                "description": "Credit balance, absent for local servers and for plans that do not\nexpose one."
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "description": "Provider or agent identifier.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/IntegrationKind",
            "description": "Which kind of integration this is."
          },
          "label": {
            "description": "Display label, so a bar can be drawn without a second lookup.",
            "type": "string"
          },
          "updated_at": {
            "description": "RFC 3339 timestamp of the last observation. A stale bar is better than a\nsilently frozen one, so the age is on the wire.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "updated_at"
        ],
        "type": "object"
      },
      "LspServerStatus": {
        "description": "Lifecycle state of a language server.",
        "enum": [
          "starting",
          "ready",
          "indexing",
          "crashed",
          "stopped"
        ],
        "type": "string"
      },
      "LspServerSummary": {
        "description": "A language server as returned by `GET /v1/lsp/servers`.",
        "properties": {
          "command": {
            "description": "Command that was spawned.",
            "type": "string"
          },
          "encoding": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PositionEncoding",
                "description": "Encoding agreed during `initialize`, absent before the handshake."
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Server identifier."
          },
          "languages": {
            "description": "Language identifiers this server is attached to.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/LspServerStatus",
            "description": "Current state."
          }
        },
        "required": [
          "id",
          "languages",
          "command",
          "status"
        ],
        "type": "object"
      },
      "MetadataSource": {
        "description": "Where a fact about a model came from.\n\nThe lab is explicit about this because the alternative — a plausible default\ncontext window — silently truncates prompts.",
        "enum": [
          "server",
          "recipe",
          "unknown"
        ],
        "type": "string"
      },
      "ModelCapabilities": {
        "description": "What a model appears able to do, as far as the server admits.",
        "properties": {
          "chat": {
            "description": "Accepts chat messages.",
            "type": "boolean"
          },
          "streaming": {
            "description": "Streams tokens rather than returning one blob.",
            "type": "boolean"
          },
          "structured_output": {
            "description": "Honours a JSON schema for output.",
            "type": "boolean"
          },
          "tools": {
            "description": "Accepts tool definitions and returns tool calls.",
            "type": "boolean"
          },
          "vision": {
            "description": "Accepts images alongside text.",
            "type": "boolean"
          }
        },
        "required": [
          "chat",
          "streaming",
          "tools",
          "structured_output",
          "vision"
        ],
        "type": "object"
      },
      "ModelRecipe": {
        "description": "A tuned configuration for one model, as returned by `GET /v1/recipes`.",
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ContextBudget",
            "description": "Context plan."
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Identifier, also the file name under `recipes/`."
          },
          "label": {
            "description": "Display label.",
            "type": "string"
          },
          "model_id": {
            "description": "Model identifier to send.",
            "type": "string"
          },
          "notes": {
            "description": "Free-text note: what this recipe is for, and what it is bad at.",
            "type": [
              "string",
              "null"
            ]
          },
          "provider_id": {
            "$ref": "#/components/schemas/String",
            "description": "Provider to call."
          },
          "sampling": {
            "$ref": "#/components/schemas/SamplingParams",
            "description": "Sampling knobs."
          },
          "schema_version": {
            "description": "Schema version, so migrations are explicit.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "system_prompt": {
            "description": "The master prompt. The whole point of the lab is editing this and seeing\nwhat changes.",
            "type": "string"
          },
          "tools": {
            "$ref": "#/components/schemas/ToolExposure",
            "description": "Tool ceiling for the promoted agent."
          },
          "updated_at": {
            "description": "RFC 3339 timestamp of the last edit.",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "id",
          "label",
          "provider_id",
          "model_id",
          "system_prompt",
          "sampling",
          "context",
          "tools",
          "updated_at"
        ],
        "type": "object"
      },
      "ModelType": {
        "description": "Broad class of a discovered model, from the server's own typing.",
        "enum": [
          "chat",
          "vision",
          "embedding",
          "other"
        ],
        "type": "string"
      },
      "PairDriverRequest": {
        "description": "Request the driver sends over the bridge to claim a pair.\n\nScopes are a request, not a grant: the daemon intersects them with what the\nuser allowed when the code was issued.",
        "properties": {
          "code": {
            "description": "The code from the cockpit.",
            "type": "string"
          },
          "name": {
            "description": "Name to record for this driver.",
            "type": "string"
          },
          "requested_scopes": {
            "description": "Scopes it would like. `answer_permissions` requires an explicit grant.",
            "items": {
              "$ref": "#/components/schemas/DriverScope"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "name",
          "requested_scopes"
        ],
        "type": "object"
      },
      "PairingCode": {
        "description": "A one-time pairing code, from `POST /v1/acp/pairings`.\n\nThe code is shown in the cockpit and typed into the driver. It is short-lived,\nsingle-use, and useless without the endpoint's token.",
        "properties": {
          "code": {
            "description": "The code to hand to the driver, for example `ALFA-NINER`.",
            "type": "string"
          },
          "expires_at": {
            "description": "RFC 3339 expiry. Two minutes by default.",
            "type": "string"
          },
          "handshake_url": {
            "description": "Where the driver should connect, when the bridge is exposed.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "expires_at"
        ],
        "type": "object"
      },
      "PermissionDecision": {
        "description": "The decision the broker applied, with its provenance.",
        "properties": {
          "at": {
            "description": "RFC 3339 timestamp of the decision.",
            "type": "string"
          },
          "decided_by": {
            "description": "Who or what decided: `user`, `policy:<rule-id>`, or `timeout`.",
            "type": "string"
          },
          "option": {
            "$ref": "#/components/schemas/PermissionOption",
            "description": "What was chosen."
          }
        },
        "required": [
          "option",
          "decided_by",
          "at"
        ],
        "type": "object"
      },
      "PermissionKind": {
        "description": "What an agent is asking to do.",
        "enum": [
          "file_write",
          "file_read",
          "terminal",
          "tool_call",
          "other"
        ],
        "type": "string"
      },
      "PermissionOption": {
        "description": "An answer the caller may give.",
        "enum": [
          "allow_once",
          "allow_always",
          "deny"
        ],
        "type": "string"
      },
      "PermissionRequest": {
        "description": "A pending request as returned by `GET /v1/permissions`.",
        "properties": {
          "created_at": {
            "description": "RFC 3339 timestamp of when the request was raised.",
            "type": "string"
          },
          "detail": {
            "description": "Full detail: the diff, the command line, the tool payload.",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Request identifier, used when answering."
          },
          "kind": {
            "$ref": "#/components/schemas/PermissionKind",
            "description": "Classification of the request."
          },
          "options": {
            "description": "Options the caller may choose from, in display order.",
            "items": {
              "$ref": "#/components/schemas/PermissionOption"
            },
            "type": "array"
          },
          "session_id": {
            "$ref": "#/components/schemas/String",
            "description": "Session that is blocked on this."
          },
          "title": {
            "description": "One-line title, safe to show in a notification.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "session_id",
          "kind",
          "title",
          "detail",
          "options",
          "created_at"
        ],
        "type": "object"
      },
      "PositionEncoding": {
        "description": "Position encoding negotiated with a server.\n\nLSP defaults to UTF-16, while the editor buffers are UTF-8 bytes; the daemon\nnegotiates explicitly and records what was agreed rather than assuming.",
        "enum": [
          "utf8",
          "utf16"
        ],
        "type": "string"
      },
      "Preferences": {
        "description": "Editor and UI preferences, per profile.\n\nDefaults are data (`defaults.toml`), not code: adding a preference should be a\none-line change that every UI picks up, and unknown keys are reported rather\nthan ignored.",
        "properties": {
          "diagnostics_min_severity": {
            "description": "Lowest diagnostic severity shown: `error`, `warning`, `information`, `hint`.",
            "type": "string"
          },
          "format_on_save": {
            "description": "Run the formatter on save when one is available.",
            "type": "boolean"
          },
          "insert_spaces": {
            "description": "Insert spaces instead of tab characters.",
            "type": "boolean"
          },
          "schema_version": {
            "description": "Schema version of this document, so migrations are explicit.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tab_width": {
            "description": "Columns per tab stop.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "theme": {
            "description": "Theme identifier for every surface that does not name its own.\n\nA theme is an extension, so this is the id of one: `acpilot.night-flight`\nunless someone says otherwise.",
            "type": "string"
          },
          "theme_gui": {
            "description": "Theme for the desktop app, when it should differ from [`Preferences::theme`].",
            "type": [
              "string",
              "null"
            ]
          },
          "theme_tui": {
            "description": "Theme for the terminal UI, when it should differ from [`Preferences::theme`].",
            "type": [
              "string",
              "null"
            ]
          },
          "theme_web": {
            "description": "Theme for the browser UI, when it should differ from [`Preferences::theme`].",
            "type": [
              "string",
              "null"
            ]
          },
          "trim_trailing_whitespace": {
            "description": "Strip trailing whitespace on save.",
            "type": "boolean"
          },
          "wrap": {
            "description": "Soft-wrap long lines.",
            "type": "boolean"
          }
        },
        "required": [
          "schema_version",
          "tab_width",
          "insert_spaces",
          "format_on_save",
          "trim_trailing_whitespace",
          "wrap",
          "theme",
          "diagnostics_min_severity"
        ],
        "type": "object"
      },
      "ProfileSummary": {
        "description": "A profile as returned by `GET /v1/profiles`.",
        "properties": {
          "active": {
            "description": "Whether this is the daemon's currently active profile.",
            "type": "boolean"
          },
          "agent_count": {
            "description": "Number of configured agents.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Profile identifier."
          },
          "label": {
            "description": "Human-readable label.",
            "type": "string"
          },
          "workspace_count": {
            "description": "Number of workspaces opened under this profile.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "label",
          "active",
          "agent_count",
          "workspace_count"
        ],
        "type": "object"
      },
      "PromoteRecipeRequest": {
        "description": "Request body for `POST /v1/recipes/{id}/promote`.",
        "properties": {
          "agent_id": {
            "description": "Agent identifier to write into `agents.toml`.",
            "type": "string"
          },
          "name": {
            "description": "Display name; the recipe label is used when absent.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "agent_id"
        ],
        "type": "object"
      },
      "PromotedAgent": {
        "description": "Result of promoting a recipe: an ordinary agent, plus the caveats.",
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/AgentSummary",
            "description": "The agent as it will now appear in `GET /v1/agents`."
          },
          "manifest_path": {
            "description": "Manifest the entry was written to, so it can be reviewed or reverted.",
            "type": "string"
          },
          "warnings": {
            "description": "Reasons to reconsider: a low tool-call validity rate, a model that the\nserver has never loaded, a window larger than the host's memory.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "agent",
          "manifest_path",
          "warnings"
        ],
        "type": "object"
      },
      "PromptAccepted": {
        "description": "Response to an accepted prompt.\n\nThe turn itself streams over SSE; this only acknowledges that it started.",
        "properties": {
          "first_seq": {
            "description": "Sequence number the client should use as `Last-Event-ID` when reconnecting.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "session_id": {
            "$ref": "#/components/schemas/String",
            "description": "Session the turn belongs to."
          },
          "turn_id": {
            "description": "Identifier for this turn, usable to correlate events and cancels.",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "turn_id",
          "first_seq"
        ],
        "type": "object"
      },
      "PromptRequest": {
        "description": "Request body for `POST /v1/sessions/{id}/prompt`.\n\n`idempotency_key` exists so a retried request cannot start a second turn —\na dropped connection must not cost the user an agent run.",
        "properties": {
          "idempotency_key": {
            "description": "Client-generated key that makes retries safe.",
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "description": "The prompt text.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "ProviderKind": {
        "description": "Which wire dialect a provider speaks.\n\n`LmStudio` reads LM Studio's native `/api/v0` surface, which reports model\nmetadata (architecture, quantization, `max_context_length`) and per-request\nstats such as time to first token. `OpenAiCompatible` is the plain\n`/v1/chat/completions` shape shared by Ollama, llama.cpp, vLLM, OpenRouter and\nhosted endpoints — fewer facts, so the UI shows fewer gauges rather than\ninventing them.\n\nAnthropic and Gemini are not OpenAI-shaped. They are added as new variants\ntogether with their adapter, never as a guess.",
        "enum": [
          "lm_studio",
          "open_ai_compatible"
        ],
        "type": "string"
      },
      "ProviderStatus": {
        "description": "Reachability of a declared provider.",
        "enum": [
          "disabled",
          "reachable",
          "unreachable",
          "unauthorized"
        ],
        "type": "string"
      },
      "ProviderSummary": {
        "description": "A provider as returned by `GET /v1/providers`.",
        "properties": {
          "base_url": {
            "description": "Base URL, for example `http://127.0.0.1:1234`.",
            "type": "string"
          },
          "credential_ref": {
            "description": "Keyring entry holding the bearer token, when the server wants one.",
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "description": "One line of human-readable detail: why it is unreachable, which runtime\nanswered, and so on. Never a token.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Identifier used in recipes."
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind",
            "description": "Wire dialect."
          },
          "label": {
            "description": "Display label.",
            "type": "string"
          },
          "last_probed_at": {
            "description": "RFC 3339 timestamp of the last probe.",
            "type": [
              "string",
              "null"
            ]
          },
          "model_count": {
            "description": "How many models the last probe saw.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/ProviderStatus",
            "description": "Current reachability."
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "base_url",
          "status",
          "model_count"
        ],
        "type": "object"
      },
      "RunRequest": {
        "description": "Request body for `POST /v1/recipes/{id}/runs`.",
        "properties": {
          "corpus": {
            "description": "Corpus pulled from the current workspace, in order.",
            "items": {
              "$ref": "#/components/schemas/CorpusSelector"
            },
            "type": "array"
          },
          "idempotency_key": {
            "description": "Client-generated key that makes retries safe.",
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "description": "The user message.",
            "type": "string"
          }
        },
        "required": [
          "prompt",
          "corpus"
        ],
        "type": "object"
      },
      "RunStatus": {
        "description": "Lifecycle of a recorded run.",
        "enum": [
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "type": "string"
      },
      "RunSummary": {
        "description": "A run as returned by `GET /v1/recipes/{id}/runs`.",
        "properties": {
          "corpus_files": {
            "description": "How many workspace files went into the prompt.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "first_token_ms": {
            "description": "Time to first token, when the transport reports it.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Run identifier."
          },
          "message": {
            "description": "Error text when the run failed.",
            "type": [
              "string",
              "null"
            ]
          },
          "params": {
            "$ref": "#/components/schemas/SamplingParams",
            "description": "The parameters actually sent, so a run can be reproduced."
          },
          "recipe_id": {
            "$ref": "#/components/schemas/String",
            "description": "Recipe this run used."
          },
          "started_at": {
            "description": "RFC 3339 timestamp of the start.",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus",
            "description": "Lifecycle state."
          },
          "stop_reason": {
            "description": "Why the server stopped: `stop`, `length`, or the server's own reason.",
            "type": [
              "string",
              "null"
            ]
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenUsage",
            "description": "Token accounting, with its provenance."
          },
          "tokens_per_second": {
            "description": "Throughput, when the server reports it.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "total_ms": {
            "description": "Wall-clock duration.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "warnings": {
            "description": "Things that went differently from the recipe: a parameter the server\nrefused, a truncated corpus, a tool call that had to be repaired.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "recipe_id",
          "status",
          "started_at",
          "tokens",
          "warnings",
          "params",
          "corpus_files"
        ],
        "type": "object"
      },
      "SamplingParams": {
        "description": "Sampling knobs, as the lab presents them.\n\nThe set is deliberately small and server-agnostic. An optional parameter the\nserver *rejects* is retried without and named in `RunSummary::warnings`: a knob\nthat silently does nothing is worse than no knob. Silent disregard cannot be\nobserved from outside a sampler, so it is not claimed either.",
        "properties": {
          "max_tokens": {
            "description": "Output cap; `null` means the server's own default.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "repeat_penalty": {
            "description": "Penalty for repeating tokens, where the server supports it.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "seed": {
            "description": "Fixed seed, so a run can be reproduced on the same server and model.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "stop": {
            "description": "Sequences that end generation.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "temperature": {
            "description": "Randomness. Agent work wants this low; drafting wants it higher.",
            "format": "float",
            "type": "number"
          },
          "top_k": {
            "description": "Top-k cutoff, where the server supports it.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "top_p": {
            "description": "Nucleus sampling cutoff.",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "temperature",
          "top_p",
          "stop"
        ],
        "type": "object"
      },
      "SessionEvent": {
        "description": "One event on a session's stream.",
        "properties": {
          "at": {
            "description": "RFC 3339 timestamp of when the daemon recorded the event.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SessionEventKind",
            "description": "What happened."
          },
          "payload": {
            "description": "Kind-specific payload.",
            "type": "object"
          },
          "seq": {
            "$ref": "#/components/schemas/u64",
            "description": "Monotonic sequence number within the session."
          },
          "session_id": {
            "$ref": "#/components/schemas/String",
            "description": "Session this event belongs to."
          }
        },
        "required": [
          "seq",
          "session_id",
          "kind",
          "at",
          "payload"
        ],
        "type": "object"
      },
      "SessionEventKind": {
        "description": "The kind of a session event.\n\nThis enum is deliberately closed: UIs switch on it exhaustively, and adding a\nvariant is a wire change that shows up in the OpenAPI snapshot. Adapter-\nspecific detail belongs in the payload, not in new kinds.",
        "enum": [
          "message_chunk",
          "thought",
          "tool_call",
          "plan",
          "mode_changed",
          "notice",
          "compaction",
          "commands_changed"
        ],
        "type": "string"
      },
      "SessionStatus": {
        "description": "Where a session is in its lifecycle.",
        "enum": [
          "idle",
          "busy",
          "awaiting_permission",
          "closed",
          "failed"
        ],
        "type": "string"
      },
      "SessionSummary": {
        "description": "A session as returned by `GET /v1/sessions`.",
        "properties": {
          "agent_id": {
            "$ref": "#/components/schemas/String",
            "description": "Agent driving the session."
          },
          "created_at": {
            "description": "RFC 3339 timestamp of creation.",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Session identifier."
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus",
            "description": "Lifecycle state."
          },
          "title": {
            "description": "Display title, derived from the first prompt when not set.",
            "type": "string"
          },
          "updated_at": {
            "description": "RFC 3339 timestamp of the last event.",
            "type": "string"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/String",
            "description": "Workspace the session edits."
          }
        },
        "required": [
          "id",
          "workspace_id",
          "agent_id",
          "title",
          "status",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "StatSource": {
        "description": "Where one figure came from.\n\nThis is recorded per figure rather than per integration: a server may report a\ncontext window but no balance, and a configured plan may name a credit ceiling\nthe server never mentions.",
        "enum": [
          "server",
          "configured",
          "estimated",
          "unknown"
        ],
        "type": "string"
      },
      "String": {
        "type": "string"
      },
      "TerminalSize": {
        "description": "Terminal dimensions in character cells.",
        "properties": {
          "cols": {
            "description": "Columns.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "rows": {
            "description": "Rows.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "cols",
          "rows"
        ],
        "type": "object"
      },
      "TerminalSummary": {
        "description": "A terminal as returned by `GET /v1/terminals`.",
        "properties": {
          "alive": {
            "description": "Whether the child process is still running.",
            "type": "boolean"
          },
          "command": {
            "description": "Command that was started, for display.",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Terminal identifier."
          },
          "session_id": {
            "$ref": "#/components/schemas/String",
            "description": "Session that owns it."
          },
          "size": {
            "$ref": "#/components/schemas/TerminalSize",
            "description": "Current dimensions."
          }
        },
        "required": [
          "id",
          "session_id",
          "size",
          "alive",
          "command"
        ],
        "type": "object"
      },
      "ThemeAppearance": {
        "description": "Light or dark, so a UI can pick the right half of a theme pair.",
        "enum": [
          "dark",
          "light"
        ],
        "type": "string"
      },
      "ThemeSummary": {
        "description": "A theme as returned by `GET /v1/themes`.\n\nThemes are the one extension kind every surface consumes, so they get a\nfirst-class route rather than being reachable only through the extension list.",
        "properties": {
          "appearance": {
            "$ref": "#/components/schemas/ThemeAppearance",
            "description": "Which half of the day it is for."
          },
          "built_in": {
            "description": "`true` for the themes compiled into the binary.",
            "type": "boolean"
          },
          "extension_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/String",
                "description": "Extension that provided it, when it did not come from the binary."
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "description": "Identifier, for example `acpilot.night-flight`.",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "appearance",
          "built_in"
        ],
        "type": "object"
      },
      "TokenUsage": {
        "description": "Token counts for a run, and whether they are trustworthy.",
        "properties": {
          "completion": {
            "description": "Completion tokens.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "estimated": {
            "description": "`true` when these are the lab's estimate rather than the server's\nreported `usage`. The UI must not style them the same way.",
            "type": "boolean"
          },
          "prompt": {
            "description": "Prompt tokens.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "prompt",
          "completion",
          "estimated"
        ],
        "type": "object"
      },
      "ToolExposure": {
        "description": "Which tools a model-backed agent may *ask* for.\n\nThis is a ceiling, not a grant. Every call still goes through the permission\nbroker; a tool left out here does not exist as far as the model is concerned,\nwhich is a much better place to enforce a boundary than a prompt.",
        "properties": {
          "max_steps": {
            "description": "Hard cap on model→tool→model steps per turn.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "read_files": {
            "description": "Offer file reads.",
            "type": "boolean"
          },
          "run_commands": {
            "description": "Offer command execution.",
            "type": "boolean"
          },
          "search": {
            "description": "Offer workspace search.",
            "type": "boolean"
          },
          "write_files": {
            "description": "Offer file writes.",
            "type": "boolean"
          }
        },
        "required": [
          "read_files",
          "write_files",
          "run_commands",
          "search",
          "max_steps"
        ],
        "type": "object"
      },
      "WorkspaceOpenRequest": {
        "description": "Request body for `POST /v1/workspaces`.\n\nOpening is idempotent: the same `host_id` + `root` pair resolves to the same\nworkspace, so a client can call this on every launch.",
        "properties": {
          "host_id": {
            "$ref": "#/components/schemas/String",
            "description": "Host to open the workspace on."
          },
          "name": {
            "description": "Optional display name.",
            "type": [
              "string",
              "null"
            ]
          },
          "root": {
            "description": "Absolute path on that host.",
            "type": "string"
          }
        },
        "required": [
          "host_id",
          "root"
        ],
        "type": "object"
      },
      "WorkspaceSummary": {
        "description": "A workspace as returned by `GET /v1/workspaces`.",
        "properties": {
          "host_id": {
            "$ref": "#/components/schemas/String",
            "description": "Host the root lives on."
          },
          "id": {
            "$ref": "#/components/schemas/String",
            "description": "Workspace identifier."
          },
          "name": {
            "description": "Display name, defaulting to the directory's basename.",
            "type": "string"
          },
          "root": {
            "description": "Root path, as the host spells it (not translated to the client's platform).",
            "type": "string"
          },
          "session_count": {
            "description": "Number of sessions recorded against this workspace.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "host_id",
          "root",
          "session_count"
        ],
        "type": "object"
      },
      "u64": {
        "format": "int64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "A TCP listener requires this on every request. The daemon writes the token to a `0600` file in its runtime directory (`token`, beside the socket) and logs the path when it binds. A request over the unix socket needs none: that transport's access control is the filesystem.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Control plane for editing and ACP agents. Clients observe state and submit intent; file contents never round-trip through this API on the keystroke path.",
    "license": {
      "name": "MIT OR Apache-2.0"
    },
    "title": "Acpilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {},
  "security": [
    {
      "bearer": []
    }
  ]
}
