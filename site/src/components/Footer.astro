---
// Starlight's footer, plus the one disclosure that belongs on every page.
//
// Overridden rather than injected by a layout because this is the component
// Starlight renders at the bottom of a page: a banner bolted on anywhere else
// would drift from where the page actually ends.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />

<p class="vibecoded">
  <strong>Vibecoded, on purpose.</strong> While I am a software developer, I lack the
  time to hand-code all my ideas, and as a result this project is vibecoded with
  <a href="https://freebuff.com">Freebuff</a>.
</p>

<style>
  .vibecoded {
    margin: 2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }
  .vibecoded strong {
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }
  .vibecoded a {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
